# v0 contract names; this file contains no credentials. Blank required fields fail closed.
# Single host with persistent storage. Runtime loading is implemented by each owner.
VESTIGE_DB_PATH=./private/vestige.db
VESTIGE_AUTH_DOMAIN=localhost:3200
VESTIGE_AUTH_URI=http://localhost:3200
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
WORLD_PROTOCOL_VERSION=4.0
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
VESTIGE_ENS_PARENT=vestige.eth
VESTIGE_PARENT_REGISTRY=
VESTIGE_ENS_EXPIRY=
ENS_REGISTRAR_PRIVATE_KEY=
VESTIGE_ATTESTER_PRIVATE_KEY=
VESTIGE_DEPLOYMENT_MANIFEST_PATH=

# Separate relayer signer. Never founder keys. No wallet password is stored here.
RELAYER_ENABLED=false
RELAYER_JOURNAL_PATH=
RELAYER_KEYSTORE_PATH=
RELAYER_KEYSTORE_NAME=
RELAYER_DAILY_WBT_BUDGET_WEI=
RELAYER_MAX_GAS_LIMIT=
RELAYER_MAX_FEE_PER_GAS_WEI=
RELAYER_L1_FEE_RESERVE_WEI=
RELAYER_MIN_BALANCE_WEI=
RELAYER_MAX_PER_MINUTE=
RELAYER_ALERT_WEBHOOK_URL=

# Public URLs must not embed private RPC credentials. Never use mock in production.
NEXT_PUBLIC_VESTIGE_ADAPTER=live
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
NEXT_PUBLIC_WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
NEXT_PUBLIC_ENS_UNIVERSAL_RESOLVER=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe
NEXT_PUBLIC_VESTIGE_DEPLOYMENT_MANIFEST_URL=

# Human-reviewed deployment command inputs; setting these grants no broadcast approval.
DEPLOYER_ADDRESS=
ATTESTER_ADDRESS=
SEAT_REGISTRY_ADDRESS=
SAFE_SETUP_ADDRESS=
EXPECTED_REGISTRY_CODEHASH=
EXPECTED_SETUP_CODEHASH=
TREASURY_SALT=
VENTURE_ID=
FOUNDER_A_ADDRESS=
FOUNDER_B_ADDRESS=
