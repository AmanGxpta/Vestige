{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfrastructureManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "sourceCommit",
    "approvedAt",
    "explorerBaseUrl",
    "contracts",
    "kind"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "chainId": {
      "const": 1874
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "explorerBaseUrl": {
      "enum": [
        "https://explorer.testnet.whitechain.io",
        "https://explorer.testnet.whitechain.io/"
      ]
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "singleton",
        "factory",
        "setup",
        "token"
      ],
      "properties": {
        "registry": {
          "$ref": "#/$defs/ContractArtifact"
        },
        "singleton": {
          "$ref": "#/$defs/ContractArtifact"
        },
        "factory": {
          "$ref": "#/$defs/ContractArtifact"
        },
        "setup": {
          "$ref": "#/$defs/ContractArtifact"
        },
        "token": {
          "$ref": "#/$defs/TokenArtifact"
        }
      }
    },
    "kind": {
      "const": "infrastructure"
    }
  },
  "$defs": {
    "ContractArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "deploymentTxHash",
        "deploymentBlock",
        "runtimeCodeHash",
        "abiPath",
        "abiSha256"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "deploymentTxHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "deploymentBlock": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeCodeHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "abiPath": {
          "type": "string",
          "pattern": "^contracts/abi/[A-Za-z0-9_.-]+\\.json$"
        },
        "abiSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifiedSourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "TokenArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "deploymentTxHash",
        "deploymentBlock",
        "runtimeCodeHash",
        "abiPath",
        "abiSha256",
        "decimals",
        "eip712Domain",
        "domainSeparator",
        "implementation"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "deploymentTxHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "deploymentBlock": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeCodeHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "abiPath": {
          "type": "string",
          "pattern": "^contracts/abi/[A-Za-z0-9_.-]+\\.json$"
        },
        "abiSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifiedSourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "decimals": {
          "const": 6
        },
        "eip712Domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "chainId",
            "verifyingContract"
          ],
          "properties": {
            "name": {
              "const": "Tether USD"
            },
            "version": {
              "const": "1"
            },
            "chainId": {
              "const": 1874
            },
            "verifyingContract": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        },
        "domainSeparator": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "implementation": {
          "$ref": "#/$defs/ContractArtifact"
        }
      }
    }
  }
}
